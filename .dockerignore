# .dockerignore
# Prevents large/irrelevant files from being sent to the IBM Cloud build context.
# Keeps build times fast and images lean.

# Python cache / bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
.Python

# Virtual environments
.venv/
venv/
env/

# Test artefacts
.pytest_cache/
.pytest_tmp/
*.pytest_tmp/
htmlcov/
.coverage

# Local database (the container uses a PVC or its own ephemeral /data)
interlock.db
*.db

# Git
.git/
.gitignore

# Editor / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Bob / AI assistant
.bob/
.bobignore

# Secrets / env
.env
.env.*
!.env.example

# Docs (not needed at runtime)
docs/
*.md
!README.md

# Other Dockerfiles (avoid polluting build context)
Dockerfile.*
docker-compose.yml
