# Interlock — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is not.
#
#   cp .env.example .env
#
# EVERYTHING IBM-RELATED IS OPTIONAL. Interlock's CLI, MCP server, PR review and
# deterministic gate all work with none of these set. The watsonx variables add
# a narration layer and an IBM-hosted surface; they never change a verdict.
#
# ---------------------------------------------------------------------------
# THE MINIMUM WORKING SET — copy these five lines and fill in three
# ---------------------------------------------------------------------------
#
#   IBM_CLOUD_API_KEY=<from IBM Cloud -> Manage -> Access (IAM) -> API keys>
#   WATSONX_PROJECT_ID=<from watsonx.ai -> Projects -> Manage -> General>
#   WATSONX_URL=https://us-south.ml.cloud.ibm.com
#   INTERLOCK_ENABLE_NARRATION=1
#   INTERLOCK_EXTERNAL_AGENT_KEY=<python -c "import secrets; print(secrets.token_urlsafe(32))">
#
# INTERLOCK_ENABLE_NARRATION=1 is the one people leave out. Without it the
# key and the project id are read and then ignored: narration, the security
# agent's model pass, LLM consumer discovery and `interlock campaign
# --request` all stay switched off, silently and by design. `interlock doctor`
# says which variable is missing; it is worth running after editing this file.
#
# Everything else in this file has a working default. Orchestrate needs two
# further variables and is genuinely optional — IBM Bob talks to the local MCP
# server and needs none of this.
#
# ---------------------------------------------------------------------------
# NEVER COMMIT REAL CREDENTIALS
# ---------------------------------------------------------------------------
# The hackathon rules are explicit: an IBM Cloud credential found in a public
# repository is deactivated immediately and the team's cloud account is
# suspended until it is removed and rotated. `.gitignore` already excludes
# `.env`, and `.bobignore` keeps these patterns out of Bob's session logs.
# Check with `git status` before every push.


# ===========================================================================
# Core — no IBM account needed
# ===========================================================================

# SQLite ledger path. Every surface (API, CLI, MCP) reads and writes this.
INTERLOCK_DB_PATH=interlock.db

# Where the Streamlit UI and the critic agent look for the API.
ORCHESTRATOR_API_URL=http://localhost:8000

# The critic agent reads evidence back over HTTP. Unset means the critic is
# skipped and a `critic_not_run` risk is recorded rather than silently omitted.
INTERLOCK_API_URL=http://localhost:8000

# Isolated copies of the component tree live here, one directory per change.
# Real runs never touch your actual source. Gitignored.
#
# Two reasons to move this when you point Interlock at your own repository:
#
#   1. Keep it OUTSIDE the components root. This path is relative by default,
#      so running against `--components-root .` from inside your own checkout
#      puts the destination inside the source, and each run copies the previous
#      run's copy. `interlock doctor --components-root .` warns when it would.
#   2. On Windows, keep it SHORT. Interlock git-inits every component here, and
#      git refuses to write objects past the 260-character path limit with
#      "Filename too long" - which surfaces as a baseline-commit failure.
INTERLOCK_WORKSPACE=.interlock_work

# Default components root when a change spec does not name one.
#
# Its immediate subdirectories are the components. Build output, dependency
# caches and dotted directories are skipped; everything else is a candidate
# consumer, so point this at the directory that holds only your services -
# `interlock discover` shows you what it would see, and suggests a better level
# when this one looks wrong.
#
# The MCP tools served over HTTP deliberately do NOT accept a components root
# as a parameter - `interlock_check` runs each component's declared test
# command, so a supervisor LLM choosing the directory would be choosing what
# gets executed. They use this value. Set it before starting uvicorn.
INTERLOCK_COMPONENTS_ROOT=fixtures


# ===========================================================================
# IBM Cloud (optional) — one key, used by everything below
# ===========================================================================
# Get it from: IBM Cloud console -> Manage -> Access (IAM) -> API keys.
# The hackathon account is pre-provisioned; region is Dallas (us-south).
IBM_CLOUD_API_KEY=

# IAM token endpoint. Only change this for a non-public IBM Cloud region.
IBM_CLOUD_IAM_URL=https://iam.cloud.ibm.com/identity/token


# ===========================================================================
# watsonx.ai (optional) — narration only, never decision
# ===========================================================================
# Interlock uses a foundation model to explain a verdict in plain language.
# It is handed an ALREADY-COMPUTED verdict and cannot alter it: the gate result
# is passed through verbatim and the model's prose is an additional field.
# See docs/adr/0002-deterministic-gate-stays-single-function.md.
#
# Leave INTERLOCK_ENABLE_NARRATION unset or 0 and no model is ever called.

# Set to 1 once WATSONX_PROJECT_ID and IBM_CLOUD_API_KEY are filled in.
INTERLOCK_ENABLE_NARRATION=0

# Regional API endpoint. Already correct for the hackathon account (Dallas),
# so leave it alone unless your project lives in another region.
#
# This is the *API* host and it always looks like https://<region>.ml.cloud.ibm.com
# - us-south, eu-de, eu-gb, jp-tok, au-syd. It is NOT the address you log in
# at: the watsonx.ai console is https://dataplatform.cloud.ibm.com/... and
# putting that here makes every narration call 404. If IBM handed you a
# "watsonx.ai URL", check which of the two it is before changing this.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# From watsonx.ai -> Projects -> your project -> Manage -> General -> Project ID.
WATSONX_PROJECT_ID=

# Use a space id INSTEAD of a project id if you deployed into a space.
WATSONX_SPACE_ID=

# Leave this alone. It is the only usable IBM chat model in this region.
#
# Verified against the live us-south catalogue on 2026-08-30 — the region
# offers 8 chat models, and exactly two are IBM's:
#
#   ibm/granite-4-h-small      30B instruct   <- the one to use
#   ibm/granite-guardian-3-8b   8B            smaller, but NOT usable here
#
# Granite Guardian is smaller and it is tempting for that reason, but it is a
# safety CLASSIFIER: it scores text for harm rather than following
# instructions. Asked to explain a verdict it returns a risk label, and asked
# for the JSON that the security and discovery agents parse it returns nothing
# they can read — so those features would silently produce no findings.
#
# ibm/granite-3-8b-instruct is NOT in this region despite appearing in IBM's
# own Prompt Lab screenshots; it was the old default and would 404.
#
# To spend fewer credits, lower WATSONX_MAX_NEW_TOKENS below or leave
# INTERLOCK_ENABLE_NARRATION at 0 — not to a smaller model, because there
# isn't a smaller one that works.
#
# Check your own account before enabling narration. This needs no credentials
# and costs nothing:
#
#   interlock models
#
# It marks the models the hackathon guide places out of scope. Do not set any
# of these: llama-3-405b-instruct, mistral-medium-2505,
# mistral-small-3-1-24b-instruct-2503.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Narration is a short summary, so keep the cap low. Credits are finite:
# 1,000 tokens = 1 RU, each RU costs $0.0001 USD, and the account is suspended
# at 100% of its $80 budget.
WATSONX_MAX_NEW_TOKENS=300

# API version date required by the watsonx.ai REST API.
WATSONX_API_VERSION=2024-10-08


# ===========================================================================
# watsonx Orchestrate (optional)
# ===========================================================================
# Interlock is exposed to Orchestrate as an MCP toolkit — the same server that
# already serves IBM Bob, Claude Code and Cursor. Nothing is reimplemented.
#
# Instance URL from: IBM Cloud -> Resource list -> AI/ML ->
# watsonx-Hackathon Orchestrate -> service credentials.
WATSONX_ORCHESTRATE_INSTANCE_URL=

# There is no separate "Orchestrate API key" to generate. deploy/watsonx/
# import.sh registers the environment with `--type ibm_iam`, which
# authenticates with an IBM Cloud IAM key - so this is normally the SAME value
# as IBM_CLOUD_API_KEY above. It is kept as its own variable so you can point
# Orchestrate at a different key later without touching narration.
WATSONX_ORCHESTRATE_API_KEY=

# ADK environment name used by `orchestrate env activate <name>`.
WATSONX_ORCHESTRATE_ENV=hackathon

# The public https URL of your tunnel, e.g. https://xxxx.trycloudflare.com
#
# The hackathon cloud account does not support solution deployment (guide p.38),
# so Interlock runs on your machine and the SaaS Orchestrate instance reaches it
# through a tunnel:
#
#   uvicorn orchestrator.main:app --port 8000
#   cloudflared tunnel --url http://localhost:8000
#
# The URL changes every time the tunnel restarts, and the toolkit has to be
# re-registered when it does. Only needed for the Orchestrate demo — IBM Bob
# talks to the stdio MCP server and needs none of this.
INTERLOCK_TUNNEL_URL=

# Shared secret that BOTH the MCP HTTP surface (/mcp) and the optional
# /chat/completions endpoint require. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty and NEITHER surface is mounted at all — they refuse to serve
# unauthenticated rather than defaulting to open, because both execute each
# component's declared test command.
INTERLOCK_EXTERNAL_AGENT_KEY=
